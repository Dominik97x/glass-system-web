{
  "stage": "C",
  "name": "Admin authentication and lead protection",
  "staticTypeCheck": {
    "command": "tsc -p tsconfig.audit-zipfix.json --pretty false",
    "passed": true
  },
  "authenticationChecks": {
    "configurationDetected": true,
    "validCredentialsAccepted": true,
    "wrongUsernameRejected": true,
    "wrongPasswordRejected": true,
    "validSignedSessionAccepted": true,
    "tamperedSessionRejected": true
  },
  "requestSecurityChecks": {
    "sameOriginAccepted": true,
    "crossOriginRejected": true,
    "fifthFailedLoginTriggersBlock": true,
