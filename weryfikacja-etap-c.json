    "/admin/leady",
    "/admin/leady/[id]",
    "status update server action",
    "GET /api/inquiries"
  ],
  "publicSurfacePreserved": "POST /api/inquiries",
  "fullNextBuildExecutedInAuditEnvironment": false,
  "note": "Final npm run lint and npm run build must be confirmed in the user's installed local environment."
