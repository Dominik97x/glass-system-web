# Calculator inquiry repository:
# local - save inquiries to local JSON file
# database - save inquiries to Postgres/Neon
# bitrix24 - send inquiries directly to Bitrix24
# hybrid - save locally and send to Bitrix24
CALCULATOR_INQUIRY_REPOSITORY=local

# Postgres / Neon database.
# Used when CALCULATOR_INQUIRY_REPOSITORY=database.
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=5

# Administrator authentication.
# Generate safe values with: npm run admin:generate-config
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12

BITRIX24_ENABLED=false
BITRIX24_WEBHOOK_URL=
# Optional public portal address used only to build safe admin links.
# When omitted, the origin is derived from BITRIX24_WEBHOOK_URL without exposing its secret path.
BITRIX24_PORTAL_URL=https://moonglass.bitrix24.pl
BITRIX24_DEAL_ENTITY_TYPE_ID=2
BITRIX24_DEAL_OWNER_TYPE=D
BITRIX24_DEFAULT_CATEGORY_ID=
BITRIX24_DEFAULT_STAGE_ID=
BITRIX24_ASSIGNED_BY_ID=
BITRIX24_SOURCE_ID=

# Calculator inquiry notifications:
# disabled - do not send notifications
# console - log notification payload to server console
# resend - send notification email through Resend
# console_and_resend - log to console and send through Resend
CALCULATOR_INQUIRY_NOTIFICATIONS=console

# Resend email notification settings.
# Required only when CALCULATOR_INQUIRY_NOTIFICATIONS=resend or console_and_resend.
RESEND_API_KEY=
CALCULATOR_INQUIRY_NOTIFICATION_FROM="Glass System <leady@twojadomena.pl>"
CALCULATOR_INQUIRY_NOTIFICATION_TO=

# Bitrix24 Provisioner (server/local scripts only).
# Never commit the real incoming webhook URL.
BITRIX24_PROVISIONER_REPORT_DIR=.bitrix24
BITRIX24_REQUEST_TIMEOUT_MS=30000
BITRIX24_RETRY_COUNT=3
# Format: depth x width; multiple dimensions separated with commas.
BITRIX24_PILOT_DIMENSIONS=300x306

# D3: production synchronization of database inquiries with Bitrix24.
# Keep CALCULATOR_INQUIRY_REPOSITORY=database. Do not use direct bitrix24/hybrid
# modes for production because Neon must remain the primary, durable record.
BITRIX24_SALES_PIPELINE_NAME="01 Sprzedaż z pomiarem"
BITRIX24_NEW_INQUIRY_STAGE_NAME="Nowe zapytanie"
BITRIX24_CALCULATOR_SOURCE_NAME="Kalkulator strony"
BITRIX24_SYNC_RETRY_DELAY_MINUTES=15
BITRIX24_VAT_RATE=8
BITRIX24_PUBLIC_CALCULATOR_URL=http://localhost:3000/kalkulator
NEXT_PUBLIC_SITE_URL=http://localhost:3000
