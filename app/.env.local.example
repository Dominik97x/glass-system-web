CALCULATOR_INQUIRY_REPOSITORY=local

BITRIX24_ENABLED=false
BITRIX24_WEBHOOK_URL=
BITRIX24_DEAL_ENTITY_TYPE_ID=2
BITRIX24_DEAL_OWNER_TYPE=D
BITRIX24_DEFAULT_CATEGORY_ID=
BITRIX24_DEFAULT_STAGE_ID=
BITRIX24_ASSIGNED_BY_ID=
BITRIX24_SOURCE_ID=

# Calculator inquiry notifications:
# disabled - do not send notifications
# console - log notification payload to server console
# resend - send notification email through Resend
# console_and_resend - log to console and send through Resend
CALCULATOR_INQUIRY_NOTIFICATIONS=console

# Resend email notification settings.
# Required only when CALCULATOR_INQUIRY_NOTIFICATIONS=resend or console_and_resend.
RESEND_API_KEY=
CALCULATOR_INQUIRY_NOTIFICATION_FROM="Glass System <leady@twojadomena.pl>"
CALCULATOR_INQUIRY_NOTIFICATION_TO=# Postgres / Neon database.
# Used by the future database calculator inquiry repository.
# Calculator inquiry repository:
# local - save inquiries to local JSON file
# database - save inquiries to Postgres/Neon
# bitrix24 - send inquiries directly to Bitrix24
# hybrid - save locally and send to Bitrix24
CALCULATOR_INQUIRY_REPOSITORY=local

# Postgres / Neon database.
# Used when CALCULATOR_INQUIRY_REPOSITORY=database.
DATABASE_URL=

# Optional. Set true if the provider requires SSL and the connection string
# does not include sslmode=require.
DATABASE_SSL=

# Optional database connection pool size.
DATABASE_POOL_MAX=5
